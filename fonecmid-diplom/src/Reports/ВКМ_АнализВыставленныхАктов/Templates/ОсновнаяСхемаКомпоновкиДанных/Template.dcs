		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.СуммаКОплатеНачальныйОстаток КАК ЗадолженностьКлиентаНаНачало,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.СуммаКОплатеПриход КАК Выполнено,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.СуммаКОплатеРасход КАК ВыставленоАктами,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.СуммаКОплатеКонечныйОстаток КАК ЗадолженностьКлиентаНаКонец,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.Клиент,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.Договор,
	ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты.Период
ИЗ
	РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.ОстаткиИОбороты(,, Месяц,,) КАК
		ВКМ_ВыполненныеКлиентуРаботыОстаткиИОбороты</query>
	</dataSet>
